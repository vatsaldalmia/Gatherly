# ─────────────────────────────────────────────────────────────────────────────
# Gatherly environment variables
# Copy to `.env` for local dev. In production (Cloudflare Workers) the SERVER vars
# below are set with `wrangler secret put NAME --name gatherly` — never committed.
# The database is Cloudflare D1, reached through a binding, not an env var.
# See DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── BUILD-TIME (client) ──────────────────────────────────────────────────────
# VITE_* vars are baked into the browser bundle at `bun run build`. They must be
# present in the shell/.env when you BUILD, and they are PUBLIC (never secret).

# Google Maps JS key used to render maps in the browser.
# Restrict this key by HTTP referrer in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Public base URL of the app; used by the better-auth browser client.
# Local dev: http://localhost:8080   Prod: https://gatherly.usegatherly.workers.dev
VITE_APP_URL=http://localhost:8080

# ── RUNTIME (server) — set as Cloudflare secrets in production ────────────────

# better-auth session signing secret. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public origin better-auth issues cookies/redirects for. Must equal the live origin.
# Local dev: http://localhost:8080   Prod: https://gatherly.usegatherly.workers.dev
BETTER_AUTH_URL=http://localhost:8080

# Google Maps server key (geocoding, Places, road distances / fairness engine).
# Can be the same key as VITE_GOOGLE_MAPS_API_KEY, but better to use a SEPARATE
# key restricted by API (Geocoding/Places/Distance Matrix) with no referrer.
GOOGLE_MAPS_API_KEY=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Google OAuth login (optional). If unset, only email/password + phone login work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone-OTP SMS via Twilio (optional, NOT free). If unset, phone OTP is a no-op
# in production; email/password login still works. Leave blank for a free deploy.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── LOCAL DEV ONLY ───────────────────────────────────────────────────────────
# `vite dev` runs on Node, where the D1 binding does not exist. getDb() then picks, in order:
#   1. the three CLOUDFLARE_* vars below -> the real remote D1, over its HTTP API
#   2. otherwise -> a local SQLite file (dev.db)
# Set these three and local dev reads AND WRITES THE PRODUCTION DATABASE. Leave them blank
# to develop against a throwaway dev.db instead. In production these are ignored: the Worker
# has the DB binding, which always wins.
#
# Create the token at https://dash.cloudflare.com/profile/api-tokens -> Create Token ->
# Custom token, with permission: Account · D1 · Edit. It is a SECRET — never commit it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Used only when the CLOUDFLARE_* vars above are unset. Defaults to file:./dev.db
# TURSO_DATABASE_URL=file:./dev.db
